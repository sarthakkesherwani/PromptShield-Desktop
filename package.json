{
  "name": "promptshield-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local Excel privacy companion",
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.promptshield.desktop",
    "productName": "PromptShield Desktop",
    "files": [
      "src/**",
      "detector-bundle.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    }
  }
}
