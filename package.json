{
  "name": "promptshield-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local Excel and Apple Numbers privacy companion",
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.promptshield.desktop",
    "productName": "PromptShield Desktop",
    "icon": "build/icon.png",
    "files": [
      "src/**",
      "detector-bundle.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "After you start monitoring, PromptShield reads active-sheet cell values from the spreadsheet app you select (Microsoft Excel or Apple Numbers) locally, to suggest masking sensitive information. Apply mask and Mask all change only the reviewed Numbers cells after your explicit click."
      },
      "artifactName": "PromptShield-Desktop-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "native/cell-anchor.node",
          "to": "cell-anchor.node"
        }
      ]
    },
    "extraResources": [
      {"from":"src/bulk-numbers-mac.js","to":"bulk-numbers-mac.js"},
      {
        "from": "src/excel-snapshot-mac.js",
        "to": "excel-snapshot-mac.js"
      },
      {
        "from": "src/numbers-snapshot-mac.js",
        "to": "numbers-snapshot-mac.js"
      },
      {
        "from": "src/focus-numbers-mac.js",
        "to": "focus-numbers-mac.js"
      }
    ]
  }
}
